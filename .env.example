# Example environment file for Cloudflare Tunnel (live server only)
#
# Copy this to .env and fill in your values.
# .env is never committed (excluded by .gitignore).

# Cloudflare tunnel ID (UUID from tunnel creation)
TUNNEL_ID=00000000-0000-0000-0000-000000000000

# Path to Cloudflare tunnel credentials file
TUNNEL_CREDENTIALS_FILE=/path/to/tunnel-credentials.json
